# Copy to .env.local for local development; set the same variables in Vercel.

# Public site URL once the domain is live (optional; Vercel's URL is used otherwise).
# NEXT_PUBLIC_SITE_URL=https://newadam.co

# Domain the event subdomains live on (default newadam.co).
# NEXT_PUBLIC_EVENTS_DOMAIN=newadam.co

# Live seat counts: one CSV link per event (server-only, never exposed to visitors).
SEATS_CSV_SALARYSTRUCTURE=

# Online payment for events through PayMongo (server-only). sk_test_… while
# testing, sk_live_… for real payments. Leave empty to hide "Pay online".
PAYMONGO_SECRET_KEY=

# Payment links emailed after the Google Form (server-only, 32+ characters).
# The same value goes in the Apps Script's Script Properties. Generate with:
#   openssl rand -base64 36
PAYMENT_LINK_SECRET=

# Optional, never in production: charge this many pesos per seat instead of the
# real price, for a small real test payment with a live key (PayMongo's minimum
# is about ₱20). Ignored on the live site.
# PAYMENT_TEST_PRICE=20
